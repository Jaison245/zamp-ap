# Copy to .env (same folder as this file) and fill in what you want to use.
# .env is gitignored — never commit real keys.

# EXTRACTOR: mock | claude | gemini | auto
#   auto (default) -> claude if ANTHROPIC_API_KEY is set, else gemini if a Gemini key
#   is set, else mock. Leave unset to use auto.
EXTRACTOR=auto

# --- Anthropic Claude (used when EXTRACTOR=claude, or auto + this key present) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# --- Google Gemini (used when EXTRACTOR=gemini, or auto + no Anthropic key but this one) ---
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Leave everything above blank to run fully offline in mock mode (deterministic,
# ground-truth-backed, zero cost — the whole pipeline and eval work with no key).
